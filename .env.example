DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_grc

# Phase 4 AI-Assisted Security Intelligence Configuration
# AI_PROVIDER options: 'gemini' (Primary Google Gemini LLM), 'local' (Deterministic expert fallback)
AI_PROVIDER=gemini

# Google Gemini Configuration (Primary Generative AI Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Fallback Configuration
# If true, falls back to deterministic RuleAssistedAIProvider if Gemini is unavailable
AI_FALLBACK_TO_LOCAL=true
