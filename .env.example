DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_grc

# =============================================================================
# Phase 4 AI-Assisted Security Intelligence Configuration
# =============================================================================

# AI Provider Mode
# Options:
#   chain         - Multi-LLM failover (DEFAULT): Gemini → OpenAI → Groq → RuleAssisted
#   gemini        - Gemini only with internal RuleAssisted fallback (Phase 4A behaviour)
#   local         - Deterministic RuleAssistedAIProvider only (offline, no API key)
#   openai-native - New OpenAIProvider only (with chain-style error typing)
#   openai        - Legacy ExternalLLMProvider (Phase 4A backward-compatible)
#   groq          - Standalone GroqProvider
AI_PROVIDER=chain

# Phase 4C: Provider Chain Order (comma-separated; 'local' always appended automatically)
# Supported values: gemini, openai, groq
# RuleAssistedAIProvider is ALWAYS appended as guaranteed final fallback.
AI_PROVIDER_CHAIN=gemini,openai,groq

# ---------------------------------------------------------------------------
# Tier 1: Google Gemini (Primary LLM)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=8
GEMINI_MAX_RETRIES=1

# ---------------------------------------------------------------------------
# Tier 2: OpenAI (Secondary LLM)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions  # Optional: Azure/proxy override
OPENAI_TIMEOUT_SECONDS=7

# ---------------------------------------------------------------------------
# Tier 3: Groq GPT-OSS 120B (Tertiary LLM)
# ---------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Fallback Configuration (applies to AI_PROVIDER=gemini standalone mode only)
# ---------------------------------------------------------------------------
# If true, standalone Gemini falls back internally to RuleAssistedAIProvider.
# Has NO effect when AI_PROVIDER=chain (chain always guarantees RuleAssisted tail).
AI_FALLBACK_TO_LOCAL=true

# =============================================================================
# Stage 13B Configuration & HTTP Security Hardening
# =============================================================================

# CORS Allowed Origins (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# HTTP Strict Transport Security (HSTS) - Only enabled on HTTPS in production
ENABLE_HSTS=false

# =============================================================================
# Stage 13D.1 Authentication & RBAC Configuration
# =============================================================================

# Mandatory in production. Minimum 32 characters recommended for HMAC-SHA256
# Generate a cryptographically random secret using:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Development / Testing Bootstrap (explicit opt-in only; default false)
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_ANALYST_PASSWORD=
AUTH_BOOTSTRAP_REVIEWER_PASSWORD=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# =============================================================================
# Stage 14B Docker Compose Deployment Configuration
# =============================================================================

# PostgreSQL Container Configuration
POSTGRES_DB=ai_grc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-secure-database-password

# Frontend Browser API Base URL
# Client requests are issued from the host browser to the exposed backend port
VITE_API_BASE_URL=http://localhost:8000

# =============================================================================
# Raspberry Pi Physical LAN Scanner Agent Configuration
# =============================================================================

# Shared bearer authentication token configured on both backend and /etc/grc-agent.env on the Pi.
# Do not commit real tokens or passwords to version control.
NMAP_AGENT_TOKEN=replace_with_shared_agent_token

# Automatically detect the active physical private LAN subnet (e.g. 192.168.1.0/24)
NMAP_AUTO_DETECT_NETWORK=true

# Intended scan subnet scope (RFC 1918, maximum /24)
NMAP_NETWORK_CIDR=

# Explicit Raspberry Pi Agent endpoint URL (leave unset to use automatic LAN agent discovery)
NMAP_AGENT_URL=
