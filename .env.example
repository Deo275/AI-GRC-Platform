DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_grc

# =============================================================================
# Phase 4 AI-Assisted Security Intelligence Configuration
# =============================================================================

# AI Provider Mode
# Options:
#   chain         - Multi-LLM failover (DEFAULT): Gemini → OpenAI → Groq → RuleAssisted
#   gemini        - Gemini only with internal RuleAssisted fallback (Phase 4A behaviour)
#   local         - Deterministic RuleAssistedAIProvider only (offline, no API key)
#   openai-native - New OpenAIProvider only (with chain-style error typing)
#   openai        - Legacy ExternalLLMProvider (Phase 4A backward-compatible)
#   groq          - Standalone GroqProvider
AI_PROVIDER=chain

# Phase 4C: Provider Chain Order (comma-separated; 'local' always appended automatically)
# Supported values: gemini, openai, groq
# RuleAssistedAIProvider is ALWAYS appended as guaranteed final fallback.
AI_PROVIDER_CHAIN=gemini,openai,groq

# ---------------------------------------------------------------------------
# Tier 1: Google Gemini (Primary LLM)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=8
GEMINI_MAX_RETRIES=1

# ---------------------------------------------------------------------------
# Tier 2: OpenAI (Secondary LLM)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions  # Optional: Azure/proxy override
OPENAI_TIMEOUT_SECONDS=7

# ---------------------------------------------------------------------------
# Tier 3: Groq GPT-OSS 120B (Tertiary LLM)
# ---------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Fallback Configuration (applies to AI_PROVIDER=gemini standalone mode only)
# ---------------------------------------------------------------------------
# If true, standalone Gemini falls back internally to RuleAssistedAIProvider.
# Has NO effect when AI_PROVIDER=chain (chain always guarantees RuleAssisted tail).
AI_FALLBACK_TO_LOCAL=true
